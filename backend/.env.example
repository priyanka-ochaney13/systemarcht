# AI Engine Configuration
# Fast API-based models (Groq / Grok)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

# Optional: Grok (xAI) API
GROK_API_KEY=your_xai_grok_api_key_here
GROK_MODEL=grok-2-mini

# Legacy Ollama (Qwen) configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=256

# Application Settings
APP_NAME="AWS Pricing Calculator"
APP_VERSION="1.0.0"
DEBUG=True

# API Settings
API_PREFIX="/api"

# CORS Settings (comma-separated for multiple origins)
CORS_ORIGINS=["*"]

# Pricing Data
PRICING_DATA_PATH="pricing_data"

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
LLM_PROVIDER=groq
# MongoDB used for pricing and service configuration
MONGODB_URI=
MONGODB_DB=capstone
SERVICE_CONFIG_SOURCE=auto

# Separate MongoDB cluster used for learning module content and user data
MONGODB_USER_URI=
MONGODB_USER_DB=capstoneuser
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json